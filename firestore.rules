rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Volunteer checks. Anyone can read. Anyone can add a well-formed check. Nobody can edit or delete.
    match /checks/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
            ['loc', 'room', 'day', 'cp', 'liquid', 'waste', 'odor', 'paper', 'soap', 'ts', 'min', 'score'])
        && request.resource.data.loc in ['g', 'f1', 'f2a', 'f2b', 'f3a', 'f3b', 'f4', 'caf', 'ww', 'wwa', 'wwb']
        && request.resource.data.room in ['B', 'G']
        && request.resource.data.day in ['ANCHOR', 'BLUE', 'SILVER']
        && request.resource.data.cp in ['P1', 'P2', 'P3', 'P4', 'P5', 'P6', 'P7', 'LA', 'LB', 'ADV', 'FLEX']
        && request.resource.data.liquid in [0, 1, 2]
        && request.resource.data.waste in [0, 1]
        && request.resource.data.odor in [0, 1]
        && request.resource.data.paper in [0, 1]
        && request.resource.data.soap in [0, 1]
        && request.resource.data.min is number
        && request.resource.data.score is number
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 21600000
        && request.resource.data.ts < request.time.toMillis() + 600000;
      allow update, delete: if false;
    }

    // "Mark cleaned" records from the custodial team.
    match /cleanings/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['loc', 'room', 'ts'])
        && request.resource.data.loc in ['g', 'f1', 'f2a', 'f2b', 'f3a', 'f3b', 'f4', 'caf', 'ww', 'wwa', 'wwb']
        && request.resource.data.room in ['B', 'G']
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 21600000
        && request.resource.data.ts < request.time.toMillis() + 600000;
      allow update, delete: if false;
    }
  }
}
